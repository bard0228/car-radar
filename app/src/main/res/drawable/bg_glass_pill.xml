<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="#00FFFFFF" />
            <stroke
                android:width="0.75dp"
                android:color="#1A0F172A" />
        </shape>
    </item>
    <item
        android:bottom="0.75dp"
        android:left="0.75dp"
        android:right="0.75dp"
        android:top="0.75dp">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:angle="135"
                android:centerColor="#82FFFFFF"
                android:endColor="#A6F0F6F3"
                android:startColor="#C4FFFFFF" />
            <stroke
                android:width="1.2dp"
                android:color="#F0FFFFFF" />
        </shape>
    </item>
</layer-list>
