<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#E8EEF6"
                android:centerColor="#EEF2F7"
                android:endColor="#EAE6DF" />
        </shape>
    </item>
    <item android:top="-120dp" android:right="-80dp">
        <shape android:shape="oval">
            <size android:width="360dp" android:height="360dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="180dp"
                android:startColor="#33D97736"
                android:endColor="#00D97736" />
        </shape>
    </item>
    <item android:bottom="-100dp" android:left="-80dp">
        <shape android:shape="oval">
            <size android:width="340dp" android:height="340dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="170dp"
                android:startColor="#2E4B73B5"
                android:endColor="#004B73B5" />
        </shape>
    </item>
</layer-list>
