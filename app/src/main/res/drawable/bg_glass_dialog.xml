<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="#00FFFFFF" />
            <stroke
                android:width="0.75dp"
                android:color="#1C0F172A" />
        </shape>
    </item>
    <item
        android:bottom="0.75dp"
        android:left="0.75dp"
        android:right="0.75dp"
        android:top="0.75dp">
        <shape android:shape="rectangle">
            <corners android:radius="25.25dp" />
            <gradient
                android:angle="135"
                android:centerColor="#EEFAFCFB"
                android:endColor="#F0EBF3EE"
                android:startColor="#F8FFFFFF" />
            <stroke
                android:width="1.25dp"
                android:color="#FFFFFFFF" />
        </shape>
    </item>
</layer-list>
