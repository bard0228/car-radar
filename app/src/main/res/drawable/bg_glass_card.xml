<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer crisp optical hairline (0.5dp rgba(15,23,42,0.10)) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="#00FFFFFF" />
            <stroke
                android:width="0.75dp"
                android:color="#1A0F172A" />
        </shape>
    </item>
    <!-- Optical translucent glass body + inner specular bevel -->
    <item
        android:bottom="0.75dp"
        android:left="0.75dp"
        android:right="0.75dp"
        android:top="0.75dp">
        <shape android:shape="rectangle">
            <corners android:radius="25.25dp" />
            <gradient
                android:angle="135"
                android:centerColor="#6EFFFFFF"
                android:endColor="#94F2F8F5"
                android:startColor="#B8FFFFFF" />
            <stroke
                android:width="1.25dp"
                android:color="#EBFFFFFF" />
        </shape>
    </item>
</layer-list>
