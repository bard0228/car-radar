<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ambient_screen"
    android:overScrollMode="always">

    <LinearLayout
        android:id="@+id/rootContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_glass_pill"
                android:contentDescription="返回"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="設定"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bluetooth Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="18dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchBtAuto"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="車機藍牙自動啟動與斷線關閉"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBtDevices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="尚未選擇車機藍牙"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickBt"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="選擇車機藍牙裝置" />
        </LinearLayout>

        <!-- Alert Distance Sliders Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="預警通報距離"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLowDist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:paddingTop="12dp"
                android:text="低速 (&lt;60 km/h)：300 m"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderLow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="50"
                android:valueFrom="150"
                android:valueTo="1200" />

            <TextView
                android:id="@+id/tvMidDist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:paddingTop="6dp"
                android:text="中速 (60~89 km/h)：500 m"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderMid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="50"
                android:valueFrom="150"
                android:valueTo="1200" />

            <TextView
                android:id="@+id/tvHighDist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:paddingTop="6dp"
                android:text="高速 (&gt;=90 km/h)：500 m"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderHigh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="50"
                android:valueFrom="150"
                android:valueTo="1200" />

            <TextView
                android:id="@+id/tvTechDist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:paddingTop="6dp"
                android:text="路口科技執法 / 闖紅燈：250 m"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderTech"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="50"
                android:valueFrom="150"
                android:valueTo="800" />
        </LinearLayout>

        <!-- Audio Focus Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="播報音訊焦點"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgAudioFocus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp">

                <RadioButton
                    android:id="@+id/rbDuck"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="導航壓低背景音樂 (Ducking)"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbMix"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="純混音不壓低音樂"
                    android:textColor="@color/text_primary" />
            </RadioGroup>
        </LinearLayout>

        <!-- Overlay Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="18dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchOverlay"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="懸浮液態球體"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgOverlayMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rbApproachOnly"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="僅接近照相機時彈出"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbAlways"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="監控中全程常駐"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOverlayPerm"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="檢查懸浮視窗權限" />
        </LinearLayout>

        <!-- Permissions & Open Data Update Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="背景權限與測速資料庫"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBgLocation"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="允許背景位置權限" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBatteryOpt"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="關閉電池最佳化 (防背景中斷)" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpdateData"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/accent_orange"
                android:text="線上更新政府測速點資料"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tvSyncStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCrashLogs"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="查看錯誤記錄" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
