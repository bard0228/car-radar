<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CarRadar" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/accent_orange</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/accent_orange_soft</item>
        <item name="colorOnPrimaryContainer">@color/accent_orange_deep</item>

        <item name="colorSecondary">@color/accent_orange</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">@color/accent_orange_soft</item>
        <item name="colorOnSecondaryContainer">@color/accent_orange_deep</item>

        <item name="colorTertiary">@color/accent_blue</item>
        <item name="colorOnTertiary">#FFFFFF</item>
        <item name="colorSurface">@color/bg_surface_elevated</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/accent_orange_soft</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/track_inactive</item>
        <item name="colorControlActivated">@color/accent_orange</item>

        <item name="android:fontFamily">@font/jakarta</item>
        <item name="fontFamily">@font/jakarta</item>
        <item name="android:windowBackground">@color/bg_base</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>

        <item name="alertDialogTheme">@style/Theme.CarRadar.Dialog</item>
        <item name="materialAlertDialogTheme">@style/Theme.CarRadar.Dialog</item>
    </style>

    <style name="Theme.CarRadar.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@drawable/bg_glass_dialog</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="colorPrimary">@color/accent_orange</item>
        <item name="colorSecondary">@color/accent_orange</item>
        <item name="android:fontFamily">@font/jakarta</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.CarRadar.Dialog</item>
    </style>

    <style name="ShapeAppearance.CarRadar.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>
</resources>
